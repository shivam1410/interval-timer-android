<?xml version="1.0" encoding="utf-8"?>
<!-- Settings + session (SharedPreferences) go to Google backup; downloaded sounds are re-fetched from GitHub. -->
<data-extraction-rules>
    <!-- The Toggl token stays on this phone: its Keystore key can't be restored elsewhere anyway. -->
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="toggl_secret.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="toggl_secret.xml" />
    </device-transfer>
</data-extraction-rules>
